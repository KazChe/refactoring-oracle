  "cases": {
    "extract-function/parking-fee": {
      "refactoring": "extract-function",
      "deterministic_tool": "rope.refactor.extract.ExtractMethod",
      "instruction": "In parking.py, extract the evening discount step of fee into a new module-level function evening_discount(base, entered_hour) that returns the discounted amount when the entry hour is 18 or later or before 6, and base unchanged otherwise. fee must call evening_discount and keep its signature fee(minutes, entered_hour) and its behavior. Do not change receipt or any other file."
    },
    "extract-function/shipping-quote": {
      "refactoring": "extract-function",
      "deterministic_tool": "rope.refactor.extract.ExtractMethod",
      "instruction": "In shipping.py, extract the two input checks at the top of quote (the unknown zone check and the positive weight check, in that order, with the same messages) into a new module-level function validate(weight_kg, zone) that returns None, and call it as the first statement of quote. Keep quote's signature and behavior. Do not change label or any other file."
    },
    "guard-clauses/discount-eligibility": {
      "refactoring": "guard-clauses",
      "deterministic_tool": null,
      "instruction": "In discount.py, rewrite discount_rate using guard clauses: return 0.0 immediately when customer is None, then return 0.0 immediately when the customer is not active, then handle the remaining cases with early returns so that no if statement is nested inside another if. The first statement of the function must be a guard. Keep the signature discount_rate(customer, order_total, coupon) and the exact behavior. Do not change final_price or any other file."
    },
    "guard-clauses/ticket-refund": {
      "refactoring": "guard-clauses",
      "deterministic_tool": null,
      "instruction": "In refund.py, rewrite refund_amount using guard clauses: return 0.0 immediately when ticket is None, then return 0.0 immediately when the ticket is used, then handle the remaining cases with early returns so that no if statement is nested inside another if. The first statement of the function must be a guard. Keep the signature refund_amount(ticket, days_before_event) and the exact behavior. Do not change refund_message or any other file."
    },
    "inline-function/log-parser": {
      "refactoring": "inline-function",
      "deterministic_tool": "rope.refactor.inline.InlineMethod",
      "instruction": "In logparse.py, inline the helper _is_level into its only caller parse_line, so the membership test appears directly in parse_line, and delete _is_level. Keep parse_line's signature and behavior. Do not change count_levels or any other file."
    },
    "inline-function/loyalty-ledger": {
      "refactoring": "inline-function",
      "deterministic_tool": "rope.refactor.inline.InlineMethod",
      "instruction": "In loyalty.py, inline the module-level helper _points_for into its only caller Ledger.purchase, so the points calculation appears directly in purchase, and delete _points_for. Keep Ledger's public methods and behavior. Do not change Ledger.__init__, Ledger.redeem, or any other file."
    },
    "introduce-parameter-object/invoice-line": {
      "refactoring": "introduce-parameter-object",
      "deterministic_tool": null,
      "instruction": "In invoice.py, introduce a dataclass Line with fields unit_price: float, quantity: int, discount_pct: float (in that order), and change line_total(unit_price, quantity, discount_pct) to line_total(line) taking one Line. invoice_total now receives a list of Line objects. describe keeps its signature describe(unit_price, quantity, discount_pct) and builds a Line to call line_total. Update tests/test_invoice.py to construct Line objects. Change nothing else."
    },
    "introduce-parameter-object/room-booking": {
      "refactoring": "introduce-parameter-object",
      "deterministic_tool": null,
      "instruction": "In booking.py, introduce a dataclass Stay with fields room_type: str, nights: int, guests: int, breakfast: bool (in that order), and change quote(room_type, nights, guests, breakfast) to quote(stay) taking one Stay. cheapest keeps its signature cheapest(nights, guests, breakfast) and builds a Stay for each room it compares. Update tests/test_booking.py to construct Stay objects. Change nothing else."
    },
    "rename/csv-cleaner": {
      "refactoring": "rename",
      "deterministic_tool": "rope.refactor.rename.Rename",
      "instruction": "In cleaner.py, rename the function clean_hdr to normalize_header, updating its definition and the call in clean_headers. Update tests/test_cleaner.py to use the new name. Change nothing else."
    },
    "rename/meeting-slots": {
      "refactoring": "rename",
      "deterministic_tool": "rope.refactor.rename.Rename",
      "instruction": "In slots.py, rename the function find_gaps to free_slots, and rename the parameter min_len to min_minutes in both find_gaps and first_gap, updating every use including the docstring and the call in first_gap. Update tests/test_slots.py to use the new names. Change nothing else."
    },
    "replace-magic-literal/late-fees": {
      "refactoring": "replace-magic-literal",
      "deterministic_tool": null,
      "instruction": "In fees.py, replace the magic numbers in late_fee with three module-level constants defined before late_fee: DVD_DAILY = 1.0, BOOK_DAILY = 0.25, and MAX_FEE = 15.0, and use them in late_fee in place of the literals (the 0 comparison and the 0.0 return stay as they are). Keep late_fee's signature and behavior. Do not change statement or any other file."
    },
    "replace-magic-literal/temperature-alerts": {
